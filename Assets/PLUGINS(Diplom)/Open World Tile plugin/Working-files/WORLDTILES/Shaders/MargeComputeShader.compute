#pragma kernel CSMain

// массив входных тайлов (Texture2DArray)
Texture2DArray<float4> Inputs;
RWTexture2D<float4> Result;
StructuredBuffer<int> HasInput;

int tileSize;
int tileCount;

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint2 size;
    Result.GetDimensions(size.x, size.y);

    if (id.x >= size.x || id.y >= size.y)
        return;

    // индекс тайла в сетке (x,y) -> index
    int tileX = id.x / tileSize;
    int tileY = id.y / tileSize;
    int index = tileY * tileCount + tileX;

    // Result is prefilled with the lower-resolution base texture. Missing
    // children keep that value instead of sampling an empty array slice.
    if (HasInput[index] == 0)
        return;

    int localX = id.x % tileSize;
    int localY = id.y % tileSize;

    // формируем int4 (x, y, slice, mip)
    int4 coord = int4(localX, localY, index, 0);
    float4 color = Inputs.Load(coord); // корректный вызов
    Result[id.xy] = color;
}
